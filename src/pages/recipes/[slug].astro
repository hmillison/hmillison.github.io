---
import BaseLayout from '../../layouts/BaseLayout.astro';
import recipes from '../../data/recipes.js';

export function getStaticPaths() {
  return recipes.map((recipe) => ({
    params: {slug: recipe.slug},
    props: {recipe},
  }));
}

const {recipe} = Astro.props;
---
<BaseLayout title={`${recipe.title} — Henry Millison`} description={recipe.summary}>
  <div class="site-shell recipe-shell" id="site-root">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Henry Millison, home">
        <span>Henry</span>
        <span>Millison</span>
      </a>
      <nav aria-label="Recipe navigation">
        <a href="/">Home</a>
        <a href="/recipes">Recipes</a>
      </nav>
      <span class="recipe-stamp" aria-hidden="true">RECIPE FILE</span>
    </header>

    <main id="main" class="recipe-main">
      <article class="recipe-page" aria-labelledby="recipe-title">
        <header class="recipe-header">
          <h1 id="recipe-title">{recipe.title}</h1>
          <p class="recipe-introduction">{recipe.introduction}</p>
        </header>

        {recipe.notes?.length > 0 && (
          <div class="recipe-notes" aria-label="Recipe notes">
            {recipe.notes.map((note) => <p>{note}</p>)}
          </div>
        )}

        <div class="recipe-columns">
          <section aria-labelledby="ingredients-title">
            <h2 id="ingredients-title">Ingredients</h2>
            <ul class="recipe-ingredients">
              {recipe.ingredients.map((ingredient) => <li>{ingredient}</li>)}
            </ul>
          </section>
          <section aria-labelledby="instructions-title">
            <h2 id="instructions-title">Instructions</h2>
            <ol class="recipe-instructions">
              {recipe.instructions.map((instruction) => <li>{instruction}</li>)}
            </ol>
          </section>
        </div>
      </article>
    </main>

    <footer class="recipe-footer">
      <a href="/recipes">← Back to recipes</a>
      <a href="/">Henry Millison</a>
    </footer>
  </div>
</BaseLayout>
